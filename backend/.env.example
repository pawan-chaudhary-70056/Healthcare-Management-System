# ---- Server ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ---- Database ----
# Replica set REQUIRED (transactions). See README for a user-space instance.
MONGO_URI=mongodb://localhost:27017/Healthcare

# ---- Security ----
# 32+ random chars. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32-please-generate
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
TRUST_PROXY=false

# ---- MFA (SEC-04) ----
# Comma-separated privileged roles forced through MFA enrollment.
MFA_REQUIRED_ROLES=admin
# AES-256-GCM key for TOTP secrets at rest. Generate: openssl rand -hex 32
MFA_ENCRYPTION_KEY=dev-only-mfa-encryption-key-change-me-32ch

# ---- Facility policy defaults (A-07 — override per deployment) ----
BOOKING_HORIZON_DAYS=14
CANCELLATION_WINDOW_MINUTES=120
NO_SHOW_GRACE_MINUTES=15
WAITLIST_OFFER_MINUTES=30
REMINDER_LEAD_HOURS=24

# ---- Background jobs (Backend Spec §6) ----
NOTIFICATION_DRAIN_SECONDS=30
REMINDER_SWEEP_MINUTES=5

# ---- Bootstrap admin (seed script only) ----
ADMIN_EMAIL=admin@hms.local
ADMIN_PASSWORD=Admin@12345
